<Window x:Class="GIS_ECP_Export.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GIS_ECP_Export"
        mc:Ignorable="d"
        Title="ГИС ЕЦП Экспорт" Height="476" Width="540"
        Closing="Window_Closing"
        Loaded="Window_Loaded">
    <!--ResizeMode="NoResize"-->

    <Grid VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" Grid.RowSpan="2">
            <Button HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="2.019,-1.701" Margin="0,20,10,0" Padding="4" Click="Settings_Button_Click" FontFamily="pack://application:,,,/Res/#Segoe MDL2 Assets" FontSize="24" Content="&#xF8B0;"   ToolTip="Настройки"/>
            <Button HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="2.019,-1.701" Margin="0,20,10,0" Padding="4" Click="Help_Button_Click" FontFamily="pack://application:,,,/Res/#Segoe MDL2 Assets" FontSize="24" FontWeight="Bold" Content="&#xE897;"   ToolTip="Справка"/>
            <Button HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="2.019,-1.701" Margin="0,20,10,0" Padding="4" Click="About_Button_Click" FontFamily="pack://application:,,,/Res/#Segoe MDL2 Assets" FontSize="24" FontWeight="Bold" Content="&#xE946;" ToolTip="О программе"/>
            <Button HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="2.019,-1.701" Margin="0,20,10,0" Padding="4" ToolTip="Поддержать проект">
                <Hyperlink NavigateUri="https://github.com/Tetrz/GIS-ECP-Export#-%D0%BF%D0%BE%D0%B4%D0%B4%D0%B5%D1%80%D0%B6%D0%B0%D1%82%D1%8C-%D0%BF%D1%80%D0%BE%D0%B5%D0%BA%D1%82"
           RequestNavigate="Donate_Button_Click" FontSize="18" FontWeight="Bold" Foreground="#c81503" TextDecorations="None" >❤</Hyperlink>
            </Button>
        </StackPanel>

        <StackPanel Margin="10,10,0,0" Orientation="Vertical" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" Grid.RowSpan="3">
            <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" Text="Дата:" FontSize="16" Width="100"/>

            <DatePicker x:Name="StartDateDatePicker"
            HorizontalAlignment="Left"
            Margin="10,0,0,0"
            FontSize="16"
            VerticalAlignment="Top" SelectedDateChanged="StartDateDatePicker_SelectedDateChanged">

                <DatePicker.CalendarStyle>
                    <Style TargetType="Calendar">

                        <Setter Property="LayoutTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="1.2"
                                    ScaleY="1.2"/>
                            </Setter.Value>
                        </Setter>

                    </Style>
                </DatePicker.CalendarStyle>

            </DatePicker>
            
        </StackPanel>
        <StackPanel Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="3" HorizontalAlignment="Center" Height="80" Width="250">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="MessageTextBlock" FontSize="16" Text="Экспорт запросов:"/>
                <TextBlock x:Name="ProgressBarTextBlock" Text="0 из 0" Margin="6,0,0,0" FontSize="16"/>
            </StackPanel>
            <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Height="20" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="3"  Grid.RowSpan="2" HorizontalAlignment="Center" Orientation="Horizontal" Margin="0,10,0,0" Height="40">

            <Button x:Name="ExportButton" Content="Экспорт" Padding="5" VerticalAlignment="Stretch" HorizontalAlignment="Left"  RenderTransformOrigin="2.019,-1.701" FontSize="14" Click="ExportRequestButton_Click"/>

            <Button x:Name="OpenFolderButton" VerticalAlignment="Stretch" HorizontalAlignment="Left"  RenderTransformOrigin="2.019,-1.701" Click="OpenFolderButton_Click" FontFamily="pack://application:,,,/Res/#Segoe MDL2 Assets" FontSize="24" Content="&#xED25;" Margin="10,0,0,0" Padding="4,2,2,2" IsEnabled="False"/>

            <Button x:Name="SignRequestsButton" Content="Подписать" Padding="5" VerticalAlignment="Stretch" HorizontalAlignment="Left"  RenderTransformOrigin="2.019,-1.701" FontSize="14" Margin="10,0,0,0" Click="SignRequestsButton_Click" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Column="0" Grid.Row="7" Grid.ColumnSpan="3" HorizontalAlignment="Left" Orientation="Horizontal" Margin="20,0,0,0">

            <TextBlock x:Name="StatusTextBlock" FontSize="16"/>
        </StackPanel>

        <StackPanel Grid.Column="0" Grid.Row="8" Grid.ColumnSpan="3" HorizontalAlignment="Left" Orientation="Horizontal" Margin="20,0,0,0">
            <TextBlock Text="Инфо: " FontSize="16"/>
            <TextBlock x:Name="InfoTextBlock" Text="..." FontSize="16"/>
        </StackPanel>

        <!-- Полоса с рекламной ссылкой. Растягивается от края до края окна.-->
        <Border Grid.Column="0" Grid.Row="9" Grid.ColumnSpan="3" Background="#2E7D32">
            <TextBlock FontSize="14"
           Foreground="White"
           TextAlignment="Center"
           TextWrapping="Wrap"
           VerticalAlignment="Center">
        <Hyperlink
            NavigateUri="https://calcs101.ru/?utm_source=gis_ecp_export&amp;utm_medium=application&amp;utm_campaign=main_link"
            RequestNavigate="AdLink_RequestNavigate"
            Foreground="White"
            TextDecorations="Underline">calcs101.ru - финансовые калькуляторы для решения ваших задач</Hyperlink>
            </TextBlock>
        </Border>
    </Grid>

</Window>