<Window x:Class="GIS_ECP_Export.EnterManuallyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GIS_ECP_Export"
        mc:Ignorable="d"
         Title="Войти вручную" WindowStartupLocation="CenterScreen"
 ResizeMode="NoResize" WindowStyle="SingleBorderWindow" Height="550" Width="620">
    <Grid>
        <StackPanel Margin="0,10,0,0" Orientation="Vertical">
            <TextBlock Margin="5,0,5,0" Text='Выполните вход через "Госуслуги" в "ГИС ЕЦП" самостоятельно. Затем после загрузки личного кабинета "ГИС ЕЦП" нажмите кнопку "OK" в текущем диалоговом окне. Начнётся процесс экспорта запросов.' TextWrapping="Wrap" FontSize="16"/>

            <Image Margin="5,10,5,0" Source="/Res/EnterManuallyDialog.png" HorizontalAlignment="Stretch"/>

            <Button Content="OK" Width="75" Height="30" Margin="0,20,0,0" FontSize="16" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
