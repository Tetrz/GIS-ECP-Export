<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net471</TargetFramework>
	<!-- Версия приложения-->
	<Version>0.9.0-alpha</Version>
	<AssemblyVersion>0.9.0.0</AssemblyVersion>
<FileVersion>0.9.0.0</FileVersion>
	<!-- Название программы. Отображается в свойствах файла и диспетчере задач.-->
	<Product>ГИС ЕЦП Экспорт</Product>
	<AssemblyTitle>ГИС ЕЦП Экспорт</AssemblyTitle>
	<Description>Автоматизированная выгрузка запросов из ГИС ЕЦП.</Description>
	<Company>Аршинов Алексей</Company>
    <LangVersion>8.0</LangVersion>
	<Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
	<UseWindowsForms>true</UseWindowsForms>
	<AssemblyName>GIS_ECP_Export</AssemblyName>
	<RootNamespace>GIS_ECP_Export</RootNamespace>
	<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
	<ApplicationIcon>Res\App.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Help.odt" />
    <None Remove="Help.pdf" />
    <None Remove="NLog.config" />
    <None Remove="Res\yandexdriver.exe" />
    <None Remove="_RES\App.ico" />
    <None Remove="_RES\App.ico~" />
    <None Remove="_RES\App_ico.kra" />
    <None Remove="_RES\App_ico.kra~" />
    <None Remove="_RES\ChatGPT Image 12 мая 2026 г., 11_17_22.png" />
    <None Remove="_RES\ChatGPT Image 21 мая 2026 г., 08_53_37.png" />
    <None Remove="_RES\ChatGPT Image 21 мая 2026 г., 09_01_33.png" />
    <None Remove="_RES\icon_pdf_download_v12.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Res\EnterManuallyDialog.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Res\Help.pdf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="NLog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Res\App.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Res\yandexdriver.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.Core" Version="4.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NLog" Version="6.0.7" />
    <PackageReference Include="PDFsharp" Version="6.1.1" />
    <PackageReference Include="Selenium.Support" Version="4.46.0" />
    <PackageReference Include="Selenium.WebDriver" Version="4.46.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
    <PackageReference Include="WindowsAPICodePackShell" Version="8.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Res\SEGMDL2.TTF" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="_RES\" />
  </ItemGroup>
  
	<!--Создаём папку Requests в папке с собранным проектом-->
	<Target Name="CreateRequestsFolder" AfterTargets="Build">
    <MakeDir Directories="$(OutDir)Requests" Condition="!Exists('$(OutDir)Requests')" />
	</Target>

</Project>